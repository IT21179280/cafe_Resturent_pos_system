{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cafepos-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=cafepos;Username=cafepos_app;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CafePOS.Api",
    "Audience": "CafePOS.Desktop",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "AllowedHosts": "*"
}
