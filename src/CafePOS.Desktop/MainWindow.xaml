<Window x:Class="CafePOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Branding.SystemName}" Height="820" Width="1440" MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Ellipse Width="230" Height="230" Fill="#14B8A6" Opacity="0.08"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-90,0"
                         IsHitTestVisible="False" />
                <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,16,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#14B8A6" ClipToBounds="True"
                                AutomationProperties.Name="Sidebar logo">
                            <Grid>
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Branding.LogoUrl, Converter={StaticResource InverseNullToVis}}" />
                                <Image Source="{Binding Branding.LogoUrl, Converter={StaticResource ImageUrl}}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding Branding.LogoUrl, Converter={StaticResource NullToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding SidebarTextVisibility}">
                            <TextBlock Text="{Binding Branding.SystemName}" Foreground="White" FontSize="15" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Branding.RestaurantName}" Foreground="#93B4B0" FontSize="9.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{Binding SidebarToggleGlyph}" ToolTip="{Binding SidebarToggleTooltip}"
                                Style="{StaticResource IconButton}" Background="Transparent" BorderBrush="Transparent"
                                Foreground="#CBD5E1" FontSize="{Binding SidebarToggleFontSize}"
                                Command="{Binding ToggleSidebarCommand}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#1E3438" BorderThickness="0,1,0,0" Padding="8,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#17343A">
                            <TextBlock Text="{Binding UserInitials}" Foreground="#CCFBF1" FontWeight="SemiBold"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                    Visibility="{Binding SidebarTextVisibility}">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRoleText}" Foreground="#93B4B0" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE7E8;" ToolTip="Sign out" Style="{StaticResource IconButton}"
                                Background="Transparent" BorderBrush="Transparent" Foreground="#93B4B0"
                                Command="{Binding LogoutCommand}" />
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Style="{StaticResource NavList}" Margin="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding DataContext.SidebarIconColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{Binding DataContext.SidebarIconFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="6,0,0,0"
                                           Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="30" CornerRadius="2" Background="{StaticResource AccentGradientBrush}"
                                Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="{Binding ClockText}" Style="{StaticResource MutedText}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="20" Padding="10,5" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#DC2626" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Fill" Value="#16A34A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Content="Refresh" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="20,16,20,16" />

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="26,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding UserRoleText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
