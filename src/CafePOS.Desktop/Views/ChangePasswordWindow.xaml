<Window x:Class="CafePOS.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Height="560" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" FontSize="22" />
            <TextBlock Text="{Binding UserEmail}" Style="{StaticResource MutedText}" Margin="0,4,0,20" />

            <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource Label}" />
            <PasswordBox x:Name="CurrentInput" PasswordChanged="OnCurrentChanged" Margin="0,0,0,12" />

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" />
            <PasswordBox x:Name="NewInput" PasswordChanged="OnNewChanged" Margin="0,0,0,12" />

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" />
            <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnConfirmChanged" Margin="0,0,0,12" />

            <TextBlock Text="Use at least 8 characters with a mix of letters, numbers and symbols."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="OnCancel" IsCancel="True" Height="40" />
                <Button Grid.Column="2" Content="Update password" Style="{StaticResource AccentButton}"
                        Click="OnSave" Height="40" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
