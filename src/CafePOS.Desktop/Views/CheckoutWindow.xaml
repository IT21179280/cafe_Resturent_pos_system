<Window x:Class="CafePOS.Desktop.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkout" Height="820" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PageBrush}">
    <Grid Margin="18">
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12,12,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Complete payment" Foreground="White" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="{Binding Order.OrderNumber}" Foreground="#CBD5E1" FontSize="12" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ShiftText}" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TotalLabel}" Foreground="#5EEAD4" FontSize="28"
                                   FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="BILL TOTAL" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Total, Converter={StaticResource Currency}}"
                                           FontSize="16" FontWeight="Bold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="ALREADY PAID" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding AlreadyPaid, Converter={StaticResource Currency}}"
                                           FontSize="16" FontWeight="Bold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="REMAINING" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding RemainingLabel}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="CHANGE DUE" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding ChangeDue, Converter={StaticResource Currency}}"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SUBTOTAL" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Order.Subtotal, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DISCOUNT" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Order.DiscountAmount, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAX" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Order.TaxAmount, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="SERVICE CHARGE" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Order.ServiceCharge, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Add a payment" Style="{StaticResource SectionTitle}" FontSize="14" />

                                <TextBlock Text="PAYMENT METHOD" Style="{StaticResource Label}" Margin="0,10,0,4" />
                                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,10">
                                    <RadioButton Content="Cash" GroupName="PaymentMethod" FontSize="14"
                                                 IsChecked="{Binding IsCashSelected}" Margin="0,0,8,0" />
                                    <RadioButton Content="Card" GroupName="PaymentMethod" FontSize="14"
                                                 IsChecked="{Binding IsCardSelected}" Margin="0,0,8,0" />
                                    <RadioButton Content="Bank transfer" GroupName="PaymentMethod" FontSize="14"
                                                 IsChecked="{Binding IsBankTransferSelected}" />
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AMOUNT" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Amount tendered" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="REFERENCE (OPTIONAL)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Card approval code or transfer reference" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Exact cash" Style="{StaticResource SmallButton}"
                                            Command="{Binding AddExactCashCommand}" />
                                    <Button Grid.Column="2" Content="Full card" Style="{StaticResource SmallButton}"
                                            Command="{Binding AddCardFullCommand}" />
                                    <Button Grid.Column="4" Content="Add payment" Style="{StaticResource AccentButton}"
                                            Command="{Binding AddPaymentCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding Payments}" MinHeight="110" MaxHeight="220"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Method" Binding="{Binding MethodLabel}" Width="120" />
                                <DataGridTextColumn Header="Amount" Width="120"
                                                    Binding="{Binding Amount, Converter={StaticResource Currency}}" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="PRINT AFTER PAYMENT" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <CheckBox Content="Customer receipt" IsChecked="{Binding PrintReceipt}" Margin="0,0,0,6" />
                        <CheckBox Content="Kitchen ticket (KOT)" IsChecked="{Binding PrintKitchenTicket}" />
                        <TextBlock Text="Kitchen tickets are sent to the kitchen printer when one is configured in Settings; otherwise the receipt printer or Windows print dialog is used."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="44" Click="OnCancel" IsCancel="True" />
                        <Button Grid.Column="2" Content="Complete sale" Style="{StaticResource AccentButton}"
                                Height="44" Click="OnComplete" IsDefault="True" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
