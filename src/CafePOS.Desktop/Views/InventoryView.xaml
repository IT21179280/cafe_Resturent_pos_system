<UserControl x:Class="CafePOS.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,13" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ingredients" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Stock levels, costs and reorder thresholds"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                         Margin="0,0,8,0" ToolTip="Search ingredients" />
                                <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}" Margin="0,0,10,0" />
                                <Button Content="Refresh" Style="{StaticResource SmallButton}"
                                        Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                                <Button Content="New" Style="{StaticResource AccentButton}"
                                        Command="{Binding NewIngredientCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ingredient" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="95" />
                            <DataGridTextColumn Header="Stock" Width="100"
                                                Binding="{Binding CurrentStock, StringFormat={}{0:0.###}}" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65" />
                            <DataGridTextColumn Header="Threshold" Width="90"
                                                Binding="{Binding LowStockThreshold, StringFormat={}{0:0.###}}" />
                            <DataGridTextColumn Header="Cost / unit" Width="110"
                                                Binding="{Binding CostPerUnit, Converter={StaticResource Currency}}" />
                            <DataGridTextColumn Header="Supplier" Binding="{Binding DefaultSupplierName}" Width="150" />
                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Padding="7,1"
                                                Background="{Binding IsLowStock, Converter={StaticResource StatusBackground}}">
                                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding IsLowStock, Converter={StaticResource StatusBrush}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Text" Value="Low stock" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Create or update an ingredient and its reorder policy."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12" />

                        <TextBlock Text="NAME" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UNIT" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OPENING STOCK" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding OpeningStockText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsExisting, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LOW STOCK AT" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding LowStockThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="COST PER UNIT" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding CostPerUnitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="DEFAULT SUPPLIER" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding DefaultSupplier}"
                                  DisplayMemberPath="Name" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save ingredient" Style="{StaticResource AccentButton}"
                                    Command="{Binding SaveCommand}" Height="36" />
                            <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" Height="36" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="STOCK ADJUSTMENT" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding CurrentStockLabel}" HorizontalAlignment="Right"
                                               FontWeight="Bold" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AdjustQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Quantity. Negative removes stock." />
                                    <TextBox Grid.Column="2" Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Reason" />
                                </Grid>
                                <Button Content="Apply adjustment" Style="{StaticResource DarkButton}" Height="36"
                                        Command="{Binding AdjustStockCommand}" HorizontalAlignment="Left" />
                                <TextBlock Text="Enter a negative quantity for wastage, spoilage or breakage."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Stock movements" Style="{StaticResource SectionTitle}" />
                </Border>
                <DataGrid ItemsSource="{Binding Movements}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Width="150"
                                            Binding="{Binding Date, Converter={StaticResource DateTime}}" />
                        <DataGridTextColumn Header="Ingredient" Binding="{Binding Ingredient}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                        <DataGridTextColumn Header="Qty" Width="100"
                                            Binding="{Binding Quantity, StringFormat={}{0:0.###}}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" />
                        <DataGridTextColumn Header="Value" Width="110"
                                            Binding="{Binding Value, Converter={StaticResource Currency}}" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="260" />
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
