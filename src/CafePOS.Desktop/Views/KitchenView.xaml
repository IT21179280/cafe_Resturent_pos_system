<UserControl x:Class="CafePOS.Desktop.Views.KitchenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Kitchen display" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Live tickets · newest orders first" Style="{StaticResource MutedText}" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Background="#FFFBEB" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock Foreground="#92400E" FontWeight="SemiBold" FontSize="12">
                            <Run Text="{Binding PendingCount, Mode=OneWay}" /> pending
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="#EFF6FF" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12">
                            <Run Text="{Binding PreparingCount, Mode=OneWay}" /> preparing
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="#F0FDF4" Padding="12,5" Margin="0,0,12,0">
                        <TextBlock Foreground="#166534" FontWeight="SemiBold" FontSize="12">
                            <Run Text="{Binding ReadyCount, Mode=OneWay}" /> ready
                        </TextBlock>
                    </Border>
                    <Button Content="Refresh" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="310" Margin="0,0,14,14" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="14,10"
                                            Background="{Binding Status, Converter={StaticResource StatusBackground}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding TableNumber, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource Badge}" Background="White" Padding="8,2">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                               FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PlacedAt, Converter={StaticResource DateTime}}"
                                                           Style="{StaticResource MutedText}" FontSize="10"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="14,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                                            <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.##}x}" />
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource MutedText}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding PreparationStation, Converter={StaticResource EnumDisplay}}"
                                                                   Style="{StaticResource MutedText}" FontSize="10" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Print ticket" Style="{StaticResource GhostButton}"
                                                    FontSize="11" Command="{Binding DataContext.PrintTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Start" Style="{StaticResource SmallButton}"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusInVis}, ConverterParameter=Pending}"
                                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Ready" Style="{StaticResource DarkButton}"
                                                        FontSize="11" Padding="10,4"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusInVis}, ConverterParameter='Pending,Preparing'}"
                                                        Command="{Binding DataContext.ReadyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Served" Style="{StaticResource AccentButton}"
                                                        FontSize="11" Padding="10,4" Margin="6,0,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusInVis}, ConverterParameter='Preparing,Ready'}"
                                                        Command="{Binding DataContext.ServedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No active kitchen tickets. New orders will appear here in real time."
                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Orders.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                    Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
