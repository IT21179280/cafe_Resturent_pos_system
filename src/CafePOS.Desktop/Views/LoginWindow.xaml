<Window x:Class="CafePOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Branding.SystemName}" Height="640" Width="1040"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#07111F" Offset="0" />
                    <GradientStop Color="#0B2D2B" Offset="0.58" />
                    <GradientStop Color="#0F766E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Ellipse Width="340" Height="340" Fill="#5EEAD4" Opacity="0.10"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-130,0" />
                <Ellipse Width="280" Height="280" Fill="#14B8A6" Opacity="0.08"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-130" />
                <Grid Margin="52">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="51" Height="51" HorizontalAlignment="Left" AutomationProperties.Name="Login logo">
                            <Border CornerRadius="13" Background="#14B8A6"
                                    Visibility="{Binding Branding.LogoUrl, Converter={StaticResource InverseNullToVis}}">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="13" Background="White"
                                    Visibility="{Binding Branding.LogoUrl, Converter={StaticResource NullToVis}}">
                                <Image Source="{Binding Branding.LogoUrl, Converter={StaticResource ImageUrl}}"
                                       Stretch="Uniform" Margin="6" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Branding.SystemName}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" Margin="0,20,0,0" TextWrapping="Wrap" MaxWidth="420"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="The complete point-of-sale system for your café or restaurant."
                                   FontSize="15" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,10,0,28"
                                   MaxWidth="400" HorizontalAlignment="Left" />
                        <StackPanel>
                            <TextBlock Text="✓  Fast counter and table service" Foreground="#E2E8F0" FontSize="13" Margin="0,5" />
                            <TextBlock Text="✓  Live kitchen display" Foreground="#E2E8F0" FontSize="13" Margin="0,5" />
                            <TextBlock Text="✓  Stock, purchasing and reports" Foreground="#E2E8F0" FontSize="13" Margin="0,5" />
                            <TextBlock Text="✓  Printer-ready customer receipts" Foreground="#E2E8F0" FontSize="13" Margin="0,5" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Secure server-backed POS · LKR" Foreground="#8FA9A6" FontSize="11"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
            <Border Style="{StaticResource Card}" Padding="30,28" MaxWidth="420" Margin="36"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="20" Padding="9,4"
                            HorizontalAlignment="Left" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource AccentDarkBrush}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="SECURE SIGN-IN" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentDarkBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Welcome back" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Sign in with your POS account." Style="{StaticResource MutedText}" Margin="0,4,0,22" />

                    <TextBlock Text="SERVER ADDRESS" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"
                             AutomationProperties.Name="Server address" />

                    <TextBlock Text="EMAIL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"
                             AutomationProperties.Name="Email" />

                    <TextBlock Text="PASSWORD" Style="{StaticResource Label}" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" KeyDown="OnPasswordKeyDown"
                                 Margin="0,0,0,14" AutomationProperties.Name="Password" />

                    <CheckBox Content="Remember my email on this device" IsChecked="{Binding RememberEmail}"
                              Margin="0,0,0,16" />

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <Button Content="Sign in" Style="{StaticResource AccentButton}" Height="44"
                            Click="OnSignIn" IsDefault="True" />
                    <Button Content="Testing…" IsEnabled="False" Height="44"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,-44,0,0" />
                    <TextBlock Text="Version 1.0 · Need help? Contact your administrator." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
