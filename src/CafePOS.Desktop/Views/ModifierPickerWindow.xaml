<Window x:Class="CafePOS.Desktop.Views.ModifierPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose modifiers" Height="520" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding ProductName}" Style="{StaticResource PageTitle}" FontSize="21" TextWrapping="Wrap" />
            <TextBlock Text="Select any extras for this item." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding PriceLabel}" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Extra charge" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding ExtraLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40" Click="OnCancel" IsCancel="True" />
                <Button Grid.Column="2" Content="Apply" Style="{StaticResource AccentButton}" Height="40"
                        Click="OnApply" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
