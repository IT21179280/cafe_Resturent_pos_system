<UserControl x:Class="CafePOS.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SEARCH" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Order number, customer or table" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATUS" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="TYPE" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="FROM" Style="{StaticResource Label}" />
                    <DatePicker SelectedDate="{Binding FromDate}" />
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <TextBlock Text="TO" Style="{StaticResource Label}" />
                    <DatePicker SelectedDate="{Binding ToDate}" />
                </StackPanel>
                <Button Grid.Column="10" Content="Apply filters" Style="{StaticResource AccentButton}"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Height="36" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="14,9" Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Previous" Style="{StaticResource SmallButton}"
                                        Command="{Binding PreviousPageCommand}" Margin="0,0,6,0" />
                                <Button Content="Next" Style="{StaticResource SmallButton}"
                                        Command="{Binding NextPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedSummary}"
                              BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="150" />
                            <DataGridTextColumn Header="Placed" Width="135"
                                                Binding="{Binding PlacedAt, Converter={StaticResource DateTime}}" />
                            <DataGridTextColumn Header="Type" Width="80"
                                                Binding="{Binding Type, Converter={StaticResource EnumDisplay}}" />
                            <DataGridTextColumn Header="Table" Binding="{Binding TableNumber}" Width="60" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="Status" Width="95"
                                                Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" />
                            <DataGridTextColumn Header="Total" Width="115"
                                                Binding="{Binding Total, Converter={StaticResource Currency}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,13" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOrder.OrderNumber, FallbackValue='No order selected'}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SelectedOrder.PlacedAt, Converter={StaticResource DateTime}}"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                    Background="{Binding SelectedOrder.Status, Converter={StaticResource StatusBackground}}">
                                <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource EnumDisplay}}"
                                           Foreground="{Binding SelectedOrder.Status, Converter={StaticResource StatusBrush}}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="ITEMS" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.##}x}" />
                                                        <Run Text="{Binding ProductName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding LineTotal, Converter={StaticResource Currency}}"
                                                               HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Currency}}"
                                                               HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Subtotal" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedOrder.Subtotal, Converter={StaticResource Currency}}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Discount" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedOrder.DiscountAmount, Converter={StaticResource Currency}}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tax" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedOrder.TaxAmount, Converter={StaticResource Currency}}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Service charge" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedOrder.ServiceCharge, Converter={StaticResource Currency}}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Total" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedTotalLabel}" HorizontalAlignment="Right"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Paid" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedOrder.PaidAmount, Converter={StaticResource Currency}}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="PAYMENTS" Style="{StaticResource Label}" Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding SelectedOrder.Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Method, Converter={StaticResource EnumDisplay}}"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding Amount, Converter={StaticResource Currency}}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="CUSTOMER" Style="{StaticResource Label}" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding SelectedOrder.CustomerName, TargetNullValue='Walk-in'}" />
                            <TextBlock Text="{Binding SelectedOrder.CustomerPhone}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding SelectedOrder.DeliveryAddress}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,14,0,10" />
                            <TextBlock Text="UPDATE STATUS" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewStatus}" />
                                <Button Grid.Column="2" Content="Apply" Style="{StaticResource AccentButton}"
                                        Command="{Binding ApplyStatusCommand}" Height="36" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Mark completed" Style="{StaticResource SmallButton}"
                                        Command="{Binding CompleteCommand}" />
                                <Button Grid.Column="2" Content="Print receipt" Style="{StaticResource SmallButton}"
                                        Command="{Binding PrintCommand}" />
                            </Grid>
                            <Button Content="Print kitchen ticket" Style="{StaticResource SmallButton}"
                                    Command="{Binding PrintKitchenTicketCommand}" Margin="0,8,0,0" />

                            <TextBlock Text="CANCEL ORDER" Style="{StaticResource Label}" Margin="0,14,0,4" />
                            <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="32" Margin="0,0,0,6" />
                            <Button Content="Cancel order" Style="{StaticResource DangerButton}" Height="34"
                                    Command="{Binding CancelCommand}" HorizontalAlignment="Left" />

                            <StackPanel Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REFUND" Style="{StaticResource Label}" Margin="0,16,0,4" />
                                <ComboBox ItemsSource="{Binding SelectedOrder.Payments}" SelectedItem="{Binding SelectedPayment}"
                                          DisplayMemberPath="Amount" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding RefundAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Refund amount" />
                                    <TextBox Grid.Column="2" Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Refund reason" />
                                </Grid>
                                <Button Content="Record refund" Style="{StaticResource DangerButton}" Height="34"
                                        Command="{Binding RefundCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,10">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
