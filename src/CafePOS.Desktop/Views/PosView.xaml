<UserControl x:Class="CafePOS.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- Menu browser -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="196" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SEARCH THE MENU" Style="{StaticResource Label}" />
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38"
                                     Padding="36,8,12,8" AutomationProperties.Name="Search the menu" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource SoftTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="13,0,0,0" />
                            <TextBlock Text="Search products, SKU or barcode…" Foreground="{StaticResource SoftTextBrush}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="38,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BROWSE BY" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding BrowseOptions}" SelectedItem="{Binding SelectedBrowseOption}"
                                  DisplayMemberPath="Name" Height="38" AutomationProperties.Name="Browse by" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Visibility="{Binding IsProductView, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CATEGORY" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name" Height="38" AutomationProperties.Name="Category" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Category-first browser -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0"
                          Visibility="{Binding IsCategoryView, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="2,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Browse the menu" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="Pick a category to see the items inside."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="{Binding CategoryCards.Count, StringFormat={}{0} categories}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CategoryCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Width="186" MinHeight="158" Padding="0" Background="White"
                                            BorderThickness="1" CornerRadius="15">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                                                                  Opacity="0.16" Color="#0F766E" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="96" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource CategoryGradientBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Ellipse Width="102" Height="102" Fill="White" Opacity="0.35"
                                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Margin="0,-44,-28,0" />
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ImageUrl, Converter={StaticResource InverseNullToVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2E8C84" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Id}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrl}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding ImageUrl, Converter={StaticResource NullToVis}}" />
                                                    <Border Style="{StaticResource Badge}" Background="#E6FFFFFF"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,8,8" Padding="7,2">
                                                        <TextBlock Text="{Binding ProductCount}" FontSize="10"
                                                                   FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="13,10,13,11">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProductCountLabel}" Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Products inside the selected category -->
            <Grid Grid.Row="1" Visibility="{Binding IsProductView, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="2,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCategory.Name}" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="Tap an item to add it to the current order."
                                           Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SmallButton}" Command="{Binding ShowCategoriesCommand}"
                                    AutomationProperties.Name="All categories">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="All categories" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            IsEnabled="{Binding IsAvailable}"
                                            AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Width="186" MinHeight="200" Padding="0" Background="White"
                                                BorderThickness="1" CornerRadius="15">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                                                                      Opacity="0.16" Color="#0F766E" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border CornerRadius="14,14,0,0" Background="{StaticResource ProductGradientBrush}"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Ellipse Width="92" Height="92" Fill="White" Opacity="0.55"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Margin="0,0,-26,0" />
                                                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                                                   Foreground="#8799AE"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding ImageUrl, Converter={StaticResource InverseNullToVis}}" />
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrl}}"
                                                               Stretch="UniformToFill"
                                                               Visibility="{Binding ImageUrl, Converter={StaticResource NullToVis}}" />
                                                        <Border Background="#E6118272" CornerRadius="20" Padding="7,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                                Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock Text="SOLD OUT" FontSize="8" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="1" Margin="13,10,13,6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               TextWrapping="Wrap" MaxHeight="38" />
                                                    <TextBlock Text="{Binding CategoryName}" Style="{StaticResource MutedText}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <Grid Grid.Row="2" Margin="13,0,13,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Price, Converter={StaticResource Currency}}"
                                                               FontWeight="Bold" FontSize="14"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <Border Grid.Column="1" Padding="6,2" Style="{StaticResource Badge}">
                                                        <TextBlock Text="{Binding PreparationStation, Converter={StaticResource EnumDisplay}}"
                                                                   FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="No products in this category."
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding Products.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
            </Grid>
        </Grid>

        <!-- Current order / cart -->
        <Grid Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="15,13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Current order" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding OrderLabel}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderStatusLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentDarkBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel Margin="15,10,15,12">
                            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="9"
                                    Padding="10,7" Margin="0,0,0,8"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#991B1B"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="9"
                                    Padding="10,7" Margin="0,0,0,8"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#065F46"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="9"
                                    Padding="10,7" Margin="0,0,0,10"
                                    Visibility="{Binding HasShift, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding ShiftWarning}" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ORDER TYPE" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding OrderTypes}" SelectedItem="{Binding SelectedOrderType}"
                                              AutomationProperties.Name="Order type">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding IsDineIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="TABLE" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                                              DisplayMemberPath="Number" AutomationProperties.Name="Table" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding ShowCustomer, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUSTOMER" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PHONE" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="DELIVERY ADDRESS" Style="{StaticResource Label}"
                                           Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVis}}" />
                                <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="ORDER NOTE" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                <TextBox Text="{Binding OrderNotes, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"
                                         AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Margin="0,10,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ITEMS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                                    <Border Style="{StaticResource Badge}" Background="#F1F5F9" Padding="7,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear cart" Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearCartCommand}" Height="28" Padding="10,2" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#EDF2F7" BorderThickness="1"
                                                CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ModifierSummary}" Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LineTotal, Converter={StaticResource Currency}}"
                                                               FontWeight="Bold" Margin="8,0,0,0" />
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Height="29">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="−" Style="{StaticResource IconButton}" Width="27" Height="27"
                                                                    Padding="0" Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding QuantityLabel}" MinWidth="24"
                                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" FontSize="12" />
                                                            <Button Content="+" Style="{StaticResource IconButton}" Width="27" Height="27"
                                                                    Padding="0" Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Grid.Column="1" Content="Modifiers" Style="{StaticResource SmallButton}"
                                                            Margin="6,0,4,0" Padding="7,3" FontSize="10"
                                                            Visibility="{Binding HasAvailableModifiers, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.EditModifiersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Disc" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                                 Width="54" Height="28" Padding="5,2" Margin="4,0,0,0"
                                                                 ToolTip="Item discount amount" />
                                                    </StackPanel>
                                                    <Button Grid.Column="5" Content="&#xE711;" Style="{StaticResource IconButton}"
                                                            Foreground="{StaticResource DangerBrush}" Margin="4,0,0,0"
                                                            Width="28" Height="28" Padding="0" Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Cart is empty. Tap a product to start an order."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,16,0,12"
                                       Visibility="{Binding Cart.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

                            <Border Background="#F8FAFC" BorderBrush="#EDF2F7" BorderThickness="1" CornerRadius="10"
                                    Padding="11,9" Margin="0,10,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Subtotal" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, Converter={StaticResource Currency}}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Discount" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, Converter={StaticResource Currency}}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tax" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TaxAmount, Converter={StaticResource Currency}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="94" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DISCOUNT" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding DiscountTypes}"
                                          SelectedItem="{Binding SelectedDiscountType}" AutomationProperties.Name="Discount type">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="4" Text="{Binding DiscountValueText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Discount value (percent or amount)" />
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="94" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SERVICE %" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0" />
                                <TextBox Grid.Column="2" Text="{Binding ServiceChargeRateText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Service charge percentage applied after discount" />
                                <TextBlock Grid.Column="4" Text="{Binding ServiceCharge, Converter={StaticResource Currency}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned checkout action bar -->
                    <Border Grid.Row="2" Background="#F8FBFF" Padding="15,12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="Incl. tax &amp; service charge" FontSize="10"
                                               Foreground="{StaticResource SoftTextBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TotalLabel}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveCommand}" Height="42"
                                        AutomationProperties.Name="Save">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Save" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding SendOrderCommand}"
                                        Style="{StaticResource DarkButton}" Height="42"
                                        AutomationProperties.Name="Send to kitchen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Send to kitchen" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Command="{Binding CheckoutCommand}" Style="{StaticResource AccentButton}" Height="46"
                                    AutomationProperties.Name="Charge">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Charge" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
