<Window x:Class="CafePOS.Desktop.Views.PurchaseOrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New purchase order" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="New purchase order" Style="{StaticResource PageTitle}" FontSize="21" />
                <TextBlock Text="Order ingredients from a supplier. Stock is updated when received."
                           Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Add line" Style="{StaticResource AccentButton}"
                    Command="{Binding AddLineCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SUPPLIER" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="NOTES" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="INGREDIENT" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="QUANTITY" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="2" Text="UNIT COST" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="3" Text="LINE TOTAL" Style="{StaticResource Label}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding Ingredients}"
                                                  SelectedItem="{Binding SelectedIngredient}" DisplayMemberPath="Name"
                                                  Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" />
                                        <TextBox Grid.Column="2" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal, Converter={StaticResource Currency}}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button Grid.Column="4" Content="&#xE711;" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="OnCancel" IsCancel="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Order total:" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Total, Converter={StaticResource Currency}}" FontWeight="Bold"
                               FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="3" Content="Create purchase order" Style="{StaticResource AccentButton}"
                        Height="42" Click="OnSave" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
