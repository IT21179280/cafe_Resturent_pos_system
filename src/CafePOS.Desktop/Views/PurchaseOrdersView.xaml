<UserControl x:Class="CafePOS.Desktop.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Purchasing" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Order ingredients and receive stock into inventory"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                              Width="170" Margin="0,0,8,0" />
                    <Button Content="Refresh" Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                    <Button Content="New purchase order" Style="{StaticResource AccentButton}"
                            Command="{Binding NewOrderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PO number" Binding="{Binding Number}" Width="160" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                        <DataGridTextColumn Header="Ordered" Width="150"
                                            Binding="{Binding OrderedAt, Converter={StaticResource DateTime}}" />
                        <DataGridTextColumn Header="Status" Width="130"
                                            Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" />
                        <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="65" />
                        <DataGridTextColumn Header="Total" Width="130"
                                            Binding="{Binding Total, Converter={StaticResource Currency}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,13" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOrder.Number, FallbackValue='No order selected'}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SelectedOrder.SupplierName}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedOrder.OrderedAt, Converter={StaticResource DateTime}}"
                                           Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                    Background="{Binding SelectedOrder.Status, Converter={StaticResource StatusBackground}}">
                                <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource EnumDisplay}}"
                                           Foreground="{Binding SelectedOrder.Status, Converter={StaticResource StatusBrush}}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="LINES" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding IngredientName}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource MutedText}">
                                                        <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.###}}" />
                                                        <Run Text="{Binding Unit, Mode=OneWay}" />
                                                        <Run Text="· received " />
                                                        <Run Text="{Binding ReceivedQuantity, Mode=OneWay, StringFormat={}{0:0.###}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                                           Text="{Binding LineTotal, Converter={StaticResource Currency}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Total" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedOrder.Total, Converter={StaticResource Currency}}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>

                            <TextBlock Text="NOTES" Style="{StaticResource Label}" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding SelectedOrder.Notes, TargetNullValue='—'}"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock Text="Created by" Style="{StaticResource Label}" Margin="0,10,0,2" />
                            <TextBlock Text="{Binding SelectedOrder.CreatedByName}" Style="{StaticResource MutedText}" />

                            <Button Content="Receive stock" Style="{StaticResource AccentButton}" Height="40"
                                    Margin="0,16,0,0" Command="{Binding ReceiveCommand}"
                                    Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CANCEL PURCHASE ORDER" Style="{StaticResource Label}" Margin="0,16,0,4" />
                                <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6" />
                                <Button Content="Cancel order" Style="{StaticResource DangerButton}" Height="36"
                                        Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
