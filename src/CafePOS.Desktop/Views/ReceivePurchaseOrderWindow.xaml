<Window x:Class="CafePOS.Desktop.Views.ReceivePurchaseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receive purchase order" Height="600" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" FontSize="21" />
            <TextBlock Text="Enter the quantity received for each line. Inventory is updated immediately."
                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            <TextBlock Text="{Binding Order.SupplierName}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INGREDIENT" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="OUTSTANDING" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="UNIT" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="3" Text="RECEIVE NOW" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="4" Text="UNIT COST" Style="{StaticResource Label}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding IngredientName}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Outstanding, StringFormat={}{0:0.###}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="3" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Item.UnitCost, Converter={StaticResource Currency}}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="OnCancel" IsCancel="True" />
                <Button Grid.Column="2" Content="Receive stock" Style="{StaticResource AccentButton}"
                        Height="42" Click="OnSave" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
