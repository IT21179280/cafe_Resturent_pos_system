<UserControl x:Class="CafePOS.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="POS branding" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="The name and logo shown on the sign-in screen and navigation sidebar."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,14" />

                    <TextBlock Text="SYSTEM NAME" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                             MaxLength="100" />

                    <TextBlock Text="LOGO" Style="{StaticResource Label}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" CornerRadius="10" Background="#F1F5F9"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{StaticResource SoftTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding LogoUrl, Converter={StaticResource InverseNullToVis}}" />
                                <Image Source="{Binding LogoUrl, Converter={StaticResource ImageUrl}}"
                                       Stretch="Uniform" Margin="6"
                                       Visibility="{Binding LogoUrl, Converter={StaticResource NullToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="PNG, JPG, GIF, WEBP or BMP · up to 5 MB"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose logo" Style="{StaticResource SmallButton}"
                                        Command="{Binding ChooseLogoCommand}" Margin="0,0,6,0" />
                                <Button Content="Remove" Style="{StaticResource GhostButton}"
                                        Command="{Binding RemoveLogoCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,4,0,14" />

                    <TextBlock Text="Restaurant profile" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Shown on receipts and reports." Style="{StaticResource MutedText}"
                               Margin="0,2,0,14" />

                    <TextBlock Text="RESTAURANT NAME" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="ADDRESS" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding RestaurantAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PHONE" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding RestaurantPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EMAIL" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding RestaurantEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERVICE CHARGE %" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ServiceChargeRateText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DEFAULT TAX %" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding DefaultTaxRateText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="RECEIPT FOOTER" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" />

                    <TextBlock Text="DEDUCT INVENTORY WHEN ORDER IS" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding InventoryEvents}" SelectedItem="{Binding InventoryDeductionEvent}"
                              Margin="0,0,0,14" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,4,0,14" />

                    <TextBlock Text="Firebase admin mirroring" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Mirror orders, sales, products, tables and stock to Firebase Realtime Database for the admin. PostgreSQL stays the source of truth and sync runs every two minutes."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,14" />

                    <TextBlock Text="FIREBASE DATABASE URL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding FirebaseDatabaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                             MaxLength="500" />
                    <TextBlock Text="Example: https://your-project-default-rtdb.firebaseio.com"
                               Style="{StaticResource MutedText}" Margin="0,0,0,10" />

                    <CheckBox Content="Enable Firebase sync" IsChecked="{Binding FirebaseSyncEnabled}" Margin="0,0,0,10" />

                    <TextBlock Text="DATABASE AUTH TOKEN (OPTIONAL)" Style="{StaticResource Label}" />
                    <PasswordBox x:Name="FirebaseTokenInput" PasswordChanged="OnFirebaseTokenChanged" Margin="0,0,0,4" />
                    <TextBlock Text="A token is saved. Leave this blank to keep it."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding FirebaseHasAuthToken, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="No token saved. Add one only if your Firebase rules require authentication."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding FirebaseHasAuthToken, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="Entering a new token replaces the saved one. The token is never shown in the app."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <CheckBox Content="Remove the saved token when saving" IsChecked="{Binding ClearFirebaseAuthToken}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="{Binding FirebaseStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Save settings" Style="{StaticResource AccentButton}" Height="38"
                                Command="{Binding SaveRestaurantCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="Sync now" Style="{StaticResource SmallButton}" Height="38"
                                Command="{Binding SyncFirebaseNowCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="This device" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Connection and receipt printer for this workstation."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,14" />

                        <TextBlock Text="SERVER ADDRESS" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                        <TextBlock Text="Example: http://192.168.1.20:5080/api/v1"
                                   Style="{StaticResource MutedText}" Margin="0,0,0,10" />

                        <CheckBox Content="Print receipts on a thermal printer" IsChecked="{Binding UseThermalPrinter}"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="PRINTER NAME (WINDOWS)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ThermalPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14" />

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,0,0,12" />
                        <CheckBox Content="Print kitchen tickets on a separate thermal printer"
                                  IsChecked="{Binding UseKitchenPrinter}" Margin="0,0,0,8" />
                        <TextBlock Text="KITCHEN PRINTER NAME (WINDOWS)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding KitchenPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="Leave this off to print kitchen tickets on the receipt printer above."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save device" Style="{StaticResource AccentButton}" Height="36"
                                    Command="{Binding SaveDeviceCommand}" Margin="0,0,6,0" />
                            <Button Content="Test connection" Style="{StaticResource SmallButton}" Height="36"
                                    Command="{Binding TestConnectionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Signed in" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding UserEmail}" Style="{StaticResource MutedText}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding UserRole, Converter={StaticResource EnumDisplay}}"
                                   FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button Content="Change password" Style="{StaticResource DarkButton}" Height="36"
                                Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
