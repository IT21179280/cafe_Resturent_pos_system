<UserControl x:Class="CafePOS.Desktop.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="18,14" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current shift" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ShiftOwner}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Padding="10,4" Margin="0,0,10,0"
                                    Background="{Binding HasOpenShift, Converter={StaticResource StatusBackground}}">
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding HasOpenShift, Converter={StaticResource StatusBrush}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="No open shift" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                                    <Setter Property="Text" Value="Open" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Content="Refresh" Style="{StaticResource SmallButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="OPENED" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.OpenedAt, Converter={StaticResource DateTime}}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="OPENING CASH" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.OpeningCash, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="CASH SALES" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.CashSales, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="EXPENSES" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.Expenses, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0"
                                           Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Rows="1" Columns="4">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="CARD SALES" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.CardSales, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="BANK SALES" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.BankSales, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="CASH REFUNDS" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.CashRefunds, Converter={StaticResource Currency}}"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="EXPECTED CASH" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentShift.ExpectedCash, Converter={StaticResource Currency}}"
                                           FontWeight="Bold" FontSize="15" Margin="0,3,0,0"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Visibility="{Binding HasNoOpenShift, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No shift is open for your account." Style="{StaticResource SectionTitle}"
                                   FontSize="14" />
                        <TextBlock Text="Open a shift before taking payments. Opening cash is the float in the drawer."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                     Margin="0,0,8,0" />
                            <Button Content="Open shift" Style="{StaticResource AccentButton}"
                                    Command="{Binding OpenShiftCommand}" Height="36" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CLOSE SHIFT" Style="{StaticResource Label}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CountedCashText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Counted cash" />
                            <TextBox Grid.Column="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Closing notes" />
                        </Grid>
                        <Button Content="Close shift" Style="{StaticResource DarkButton}" Height="38"
                                Command="{Binding CloseShiftCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Recent shifts" Style="{StaticResource SectionTitle}" />
                    </Border>
                    <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cashier" Binding="{Binding UserName}" Width="*" />
                            <DataGridTextColumn Header="Opened" Width="140"
                                                Binding="{Binding OpenedAt, Converter={StaticResource DateTime}}" />
                            <DataGridTextColumn Header="Closed" Width="140"
                                                Binding="{Binding ClosedAt, Converter={StaticResource DateTime}}" />
                            <DataGridTextColumn Header="Opening" Width="105"
                                                Binding="{Binding OpeningCash, Converter={StaticResource Currency}}" />
                            <DataGridTextColumn Header="Expected" Width="105"
                                                Binding="{Binding ExpectedCash, Converter={StaticResource Currency}}" />
                            <DataGridTextColumn Header="Counted" Width="105"
                                                Binding="{Binding CountedCash, Converter={StaticResource Currency}}" />
                            <DataGridTextColumn Header="Difference" Width="105"
                                                Binding="{Binding Difference, Converter={StaticResource Currency}}" />
                            <DataGridTextColumn Header="Status" Width="80"
                                                Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Record expense" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Petty cash taken from the drawer during the shift."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10" />

                        <TextBlock Text="DESCRIPTION" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AMOUNT" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ExpenseAmountText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CATEGORY" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding ExpenseCategories}"
                                          SelectedItem="{Binding ExpenseCategory}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Add expense" Style="{StaticResource AccentButton}" Height="36"
                                Command="{Binding AddExpenseCommand}" HorizontalAlignment="Left" />

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,12" />

                        <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Reopen selected shift" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <TextBlock Text="Managers can reopen a closed shift with an audit reason."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <TextBox Text="{Binding ReopenReason, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8" ToolTip="Reason for reopening" />
                            <Button Content="Reopen shift" Style="{StaticResource SmallButton}"
                                    Command="{Binding ReopenShiftCommand}" HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
