<UserControl x:Class="CafePOS.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,13" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Suppliers" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                <Run Text="Total payable:" />
                                <Run Text="{Binding TotalPayable, Mode=OneWay, Converter={StaticResource Currency}}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="180"
                                     Margin="0,0,8,0" ToolTip="Search suppliers" />
                            <Button Content="Search" Style="{StaticResource SmallButton}"
                                    Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Content="New supplier" Style="{StaticResource AccentButton}"
                                    Command="{Binding NewSupplierCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="160" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                        <DataGridTextColumn Header="Balance" Width="130"
                                            Binding="{Binding Balance, Converter={StaticResource Currency}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Supplier contact details and notes." Style="{StaticResource MutedText}"
                               Margin="0,2,0,12" />

                    <TextBlock Text="NAME" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="CONTACT PERSON" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PHONE" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EMAIL" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ADDRESS" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MinHeight="56"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" />

                    <TextBlock Text="NOTES" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="70"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save supplier" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}" Height="36" />
                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}" Height="36" />
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
