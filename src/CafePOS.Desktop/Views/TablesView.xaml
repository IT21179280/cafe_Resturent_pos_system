<UserControl x:Class="CafePOS.Desktop.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dining floor" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                            <Run Text="{Binding AvailableCount, Mode=OneWay}" /> available ·
                            <Run Text="{Binding OccupiedCount, Mode=OneWay}" /> occupied ·
                            <Run Text="{Binding ReservedCount, Mode=OneWay}" /> reserved
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="New table" Style="{StaticResource SmallButton}"
                                Command="{Binding NewTableCommand}" Margin="0,0,6,0" />
                        <Button Content="Refresh" Style="{StaticResource SmallButton}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="12" BorderBrush="Transparent"
                                                BorderThickness="2" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="154" Height="132" Padding="14"
                                    Background="{Binding Status, Converter={StaticResource StatusBackground}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Capacity, StringFormat={}{0} pax}"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Area, TargetNullValue='Main area'}"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding CurrentOrderNumber}" FontSize="11"
                                                   Foreground="{StaticResource AccentDarkBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Row="2" Style="{StaticResource Badge}" Padding="7,2"
                                            Background="White">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Select a table to edit it, or create a new table." Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,2,0,14" />

                    <TextBlock Text="NUMBER" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding TableNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CAPACITY" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding TableCapacity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DISPLAY ORDER" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding TableDisplayOrder, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="AREA" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding TableArea, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save table" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}" Height="36" />
                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}" Height="36" />
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,12" />
                    <TextBlock Text="SERVICE ACTIONS" Style="{StaticResource Label}" />
                    <Button Content="Open table in POS" Style="{StaticResource DarkButton}" Height="38"
                            Command="{Binding OpenPosCommand}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="View order" Style="{StaticResource SmallButton}"
                                Command="{Binding ViewOrderCommand}" />
                        <Button Grid.Column="2" Content="Free table" Style="{StaticResource SmallButton}"
                                Command="{Binding SetAvailableCommand}" />
                    </Grid>
                    <Button Content="Mark reserved" Style="{StaticResource SmallButton}"
                            Command="{Binding SetReservedCommand}" HorizontalAlignment="Left" />

                    <TextBlock Text="OPEN ORDER" Style="{StaticResource Label}" Margin="0,16,0,4" />
                    <TextBlock Text="No order loaded. Use View order to preview the active bill."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Visibility="{Binding HasOrder, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel Visibility="{Binding HasOrder, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding SelectedOrder.OrderNumber}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedOrder.Total, Converter={StaticResource Currency}}"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource EnumDisplay}}"
                                   Style="{StaticResource MutedText}" Margin="0,2,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.##}x}" />
                                            <Run Text="{Binding ProductName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" FontSize="12"
                                                   Text="{Binding LineTotal, Converter={StaticResource Currency}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
