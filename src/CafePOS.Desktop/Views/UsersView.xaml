<UserControl x:Class="CafePOS.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,13" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Team accounts" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Roles control what each person can access"
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Refresh" Style="{StaticResource SmallButton}"
                                    Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Content="New user" Style="{StaticResource AccentButton}"
                                    Command="{Binding NewUserCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                        <DataGridTextColumn Header="Role" Width="110"
                                            Binding="{Binding RoleName, Converter={StaticResource EnumDisplay}}" />
                        <DataGridTemplateColumn Header="Active" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Padding="7,1"
                                            Background="{Binding IsActive, Converter={StaticResource StatusBackground}}">
                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding IsActive, Converter={StaticResource StatusBrush}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Disabled" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last login" Width="150"
                                            Binding="{Binding LastLoginAt, Converter={StaticResource DateTime}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Create an account or update role and access."
                               Style="{StaticResource MutedText}" Margin="0,2,0,12" />

                    <TextBlock Text="FULL NAME" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="EMAIL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                             IsEnabled="{Binding IsExisting, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="ROLE" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Account is active" IsChecked="{Binding IsActive}" Margin="0,4,0,12" />
                        <TextBlock Text="This is your own account. Role and access changes may sign you out."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="INITIAL PASSWORD" Style="{StaticResource Label}" />
                        <PasswordBox PasswordChanged="OnPasswordChanged" Margin="0,0,0,12" />
                    </StackPanel>

                    <Button Content="Save user" Style="{StaticResource AccentButton}" Height="36"
                            Command="{Binding SaveCommand}" Margin="0,0,0,10" />

                    <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,4,0,12" />

                        <TextBlock Text="Reset password" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <TextBlock Text="The user will be required to change it at next sign-in."
                                   Style="{StaticResource MutedText}" Margin="0,2,0,8" />
                        <PasswordBox PasswordChanged="OnResetPasswordChanged" Margin="0,0,0,8" />
                        <Button Content="Reset password" Style="{StaticResource SmallButton}" Height="34"
                                Command="{Binding ResetPasswordCommand}" HorizontalAlignment="Left"
                                Margin="0,0,0,12" />

                        <TextBlock Text="Sessions" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <TextBlock Text="Revoke every refresh token so the user is signed out on all devices."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <Button Content="Sign out all devices" Style="{StaticResource DangerButton}" Height="34"
                                Command="{Binding RevokeSessionsCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
